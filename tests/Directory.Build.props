<?xml version="1.0" encoding="utf-8"?>
<!-- https://docs.microsoft.com/en-us/visualstudio/msbuild/customize-your-build -->
<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <NoWarn>CS1587,CS1591,CS1998,NU5105</NoWarn>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Label="Testing Platform" Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup Label="Test Framework">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <ItemGroup Label="Shared Test Infrastructure" Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Shared\Tests.Shared\Vertical.Slice.Template.TestsShared.csproj" />
  </ItemGroup>

  <ItemGroup Label="Testing Platform Packages" Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests'))">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup Label="Testing Imports" Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests')) Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('TestShared'))">
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Label="Legacy Test Runner Cleanup" Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('Tests')) Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('TestShared'))">
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <PackageReference Remove="coverlet.msbuild" />
    <PackageReference Remove="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
